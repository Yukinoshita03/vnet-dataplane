      "kind": "compute_agent",
      "command": [
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/etc/vnet-dataplane-agent/lab-known-hosts.p1",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "ConnectTimeout=5",
        "compute2",
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/cat",
        "/run/vnet-dataplane-agent/state.json"
      ]
    },
