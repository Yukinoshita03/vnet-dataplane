VNET_AGENT_SCRIPT=/opt/vnet-dataplane/linux_accel/agent/openstack_dataplane_agent.py
VNET_ENDPOINT_CONFIG=/etc/vnet-dataplane-agent/endpoints.json
VNET_LOCAL_HOST=REPLACE_COMPUTE_HOST
VNET_DNS_MONITOR=/opt/vnet-dataplane/linux_accel/build/dns_monitor
VNET_DNS_CLIENT_BPF=/opt/vnet-dataplane/linux_accel/build/dns_client_cache.bpf.o
VNET_DNS_TC_BPF=/opt/vnet-dataplane/linux_accel/build/dns_monitor.bpf.o
VNET_GRPC_MONITOR=/opt/vnet-dataplane/linux_accel/build/grpc_monitor
VNET_GRPC_BPF=/opt/vnet-dataplane/linux_accel/build/grpc_monitor.bpf.o
VNET_CACHE_POLICY_TXN=/opt/vnet-dataplane/linux_accel/build/cache_policy_txn
VNET_AGENT_INTERVAL=2
VNET_MISSING_GRACE_CYCLES=2
