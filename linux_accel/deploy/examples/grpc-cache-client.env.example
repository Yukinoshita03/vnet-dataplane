VNET_GRPC_FAST_CACHE=/opt/vnet-dataplane/linux_accel/build/grpc_fast_cache
VNET_GRPC_POLICY_MAP=/sys/fs/bpf/vnet-dataplane-agent/REPLACE_CLIENT_PORT/grpc/grpc_policy_map
VNET_GRPC_RESPONSE_MAP=/sys/fs/bpf/vnet-dataplane-agent/REPLACE_CLIENT_PORT/grpc/grpc_response_cache
VNET_GRPC_RUNTIME_MAP=/sys/fs/bpf/vnet-dataplane-agent/REPLACE_CLIENT_PORT/grpc/cache_runtime_control
VNET_GRPC_LISTEN=127.0.0.1:15052
VNET_GRPC_BACKEND=127.0.0.1:16052
VNET_GRPC_METHOD=/vnet.Probe/Check
VNET_GRPC_LOG_DIR=/var/log/vnet-dataplane-agent/REPLACE_CLIENT_PORT
VNET_GRPC_LOG_FILE=/var/log/vnet-dataplane-agent/REPLACE_CLIENT_PORT/grpc-fast-cache.log
