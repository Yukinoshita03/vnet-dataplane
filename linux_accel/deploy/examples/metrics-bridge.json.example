{
  "schema_version": 1,
  "desired_mode_file": "/run/vnet-dataplane-metrics-controller/desired-mode.json",
  "controller_mode_file": "/run/vnet-dataplane-metrics-controller/controller-mode.json",
  "controller_command": [
    "/opt/vnet-dataplane/linux_accel/build/dynamic_cache_controller",
    "--desired-mode-file",
    "/run/vnet-dataplane-metrics-controller/controller-mode.json",
    "--initial-mode",
    "bypass",
    "--window-size",
    "5",
    "--required-windows",
    "2",
    "--cooldown-ms",
    "10000"
  ],
  "poll_interval_seconds": 1.0,
  "source_timeout_seconds": 3.0,
  "decision_timeout_seconds": 3.0,
  "stop_timeout_seconds": 5.0,
  "max_snapshot_age_seconds": 5.0,
  "max_future_skew_seconds": 2.0,
  "max_snapshot_bytes": 262144,
  "sources": [
    {
      "name": "master-dns-client-monitor",
      "kind": "dns_metrics",
      "role": "client",
      "path": "/var/log/vnet-dataplane-agent/REPLACE_CLIENT_PORT/dns-REPLACE_MASTER_TAP.log"
    },
    {
      "name": "compute2-dns-client-monitor",
      "kind": "dns_metrics",
      "role": "client",
      "command": [
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/etc/vnet-dataplane-agent/known_hosts",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "ConnectTimeout=3",
        "REPLACE_COMPUTE2_HOST",
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/python3",
        "/opt/vnet-dataplane/linux_accel/agent/openstack_metrics_bridge.py",
        "snapshot-log",
        "--path",
        "/var/log/vnet-dataplane-agent/REPLACE_CLIENT_PORT/dns-REPLACE_COMPUTE2_TAP.log",
        "--max-bytes",
        "262144"
      ]
    },
    {
      "name": "master-grpc-client-monitor",
      "kind": "grpc_metrics",
      "role": "client",
      "error_authoritative": false,
      "path": "/var/log/vnet-dataplane-agent/REPLACE_CLIENT_PORT/grpc-REPLACE_MASTER_TAP.log"
    },
    {
      "name": "compute2-grpc-client-monitor",
      "kind": "grpc_metrics",
      "role": "client",
      "error_authoritative": false,
      "command": [
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/etc/vnet-dataplane-agent/known_hosts",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "ConnectTimeout=3",
        "REPLACE_COMPUTE2_HOST",
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/python3",
        "/opt/vnet-dataplane/linux_accel/agent/openstack_metrics_bridge.py",
        "snapshot-log",
        "--path",
        "/var/log/vnet-dataplane-agent/REPLACE_CLIENT_PORT/grpc-REPLACE_COMPUTE2_TAP.log",
        "--max-bytes",
        "262144"
      ]
    },
    {
      "name": "server-guest-dns-cache",
      "kind": "dns_metrics",
      "role": "server",
      "error_authoritative": false,
      "command": [
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/etc/vnet-dataplane-agent/known_hosts",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "ConnectTimeout=3",
        "REPLACE_SERVER_GUEST_HOST",
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/python3",
        "/opt/vnet-dataplane/linux_accel/agent/openstack_metrics_bridge.py",
        "snapshot-log",
        "--path",
        "/var/log/vnet-dataplane-guest/REPLACE_SERVER_PORT/dns-monitor.log",
        "--max-bytes",
        "262144"
      ]
    },
    {
      "name": "client-guest-grpc-cache",
      "kind": "grpc_fast_cache",
      "role": "client",
      "command": [
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/etc/vnet-dataplane-agent/known_hosts",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "ConnectTimeout=3",
        "REPLACE_CLIENT_GUEST_HOST",
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/python3",
        "/opt/vnet-dataplane/linux_accel/agent/openstack_metrics_bridge.py",
        "snapshot-log",
        "--path",
        "/var/log/vnet-dataplane-guest/REPLACE_CLIENT_PORT/grpc-fast-cache.log",
        "--max-bytes",
        "262144"
      ]
    },
    {
      "name": "server-guest-grpc-cache",
      "kind": "grpc_fast_cache",
      "role": "server",
      "command": [
        "/usr/bin/ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "UserKnownHostsFile=/etc/vnet-dataplane-agent/known_hosts",
        "-o",
        "HostKeyAlgorithms=ssh-ed25519",
        "-o",
        "ConnectTimeout=3",
        "REPLACE_SERVER_GUEST_HOST",
        "/usr/bin/sudo",
        "-n",
        "/usr/bin/python3",
        "/opt/vnet-dataplane/linux_accel/agent/openstack_metrics_bridge.py",
        "snapshot-log",
        "--path",
        "/var/log/vnet-dataplane-guest/REPLACE_SERVER_PORT/grpc-fast-cache.log",
        "--max-bytes",
        "262144"
      ]
    }
  ]
}
